# Copy to .env and fill in. Never commit .env.

# Port to listen on
PORT=3000

# Google Maps JavaScript API key (optional).
# If empty, the app falls back to OpenStreetMap tiles via Leaflet (no key, no Google account needed).
# If you use Google Maps, restrict the key in Google Cloud Console to your domain (HTTP referrer)
# and to the "Maps JavaScript API" only.
GOOGLE_MAPS_API_KEY=

# Where the SQLite database and uploaded photos live
DATA_DIR=./data

# Default map centre (Thailand)
MAP_CENTER_LAT=13.7563
MAP_CENTER_LNG=100.5018
MAP_ZOOM=6

# Require a photo (taken with the in-app camera) on every report. "false" allows text-only.
PHOTO_REQUIRED=true
# Reject a photo that matches one submitted within this many days (perceptual hash)
DUPLICATE_WINDOW_DAYS=90

# Automatic deletion is OFF by default (0 = never). Set days to enable.
FOUND_TTL_DAYS=0
RETURNED_TTL_DAYS=0

# Set to "true" when running behind a reverse proxy (nginx, Caddy, Cloudflare)
# so rate limiting sees the real client IP from X-Forwarded-For.
TRUST_PROXY=false

# Optional moderator secret (at least 24 random characters). When set, it can be
# entered in place of a report's own management code to mark/delete ANY report,
# so spam can be removed. Generate one with:  openssl rand -base64 32
# Keep it secret; it is never written to disk or sent to browsers.
ADMIN_TOKEN=
# Secret path of the moderator page (no leading slash). Pick something long and random;
# the page is then https://your-site/<ADMIN_PATH>. Default "admin".
ADMIN_PATH=admin

# Optional: AI plate reading from photos (Claude vision). Leave empty to disable;
# the form then works manually. Get a key at https://platform.claude.com
# Note: the key is tied to an Anthropic account with a payment method.
ANTHROPIC_API_KEY=
# Model for reading plates. Default is the most accurate; set to claude-sonnet-5
# or claude-haiku-4-5 to cut cost per photo.
OCR_MODEL=claude-opus-5
# Global cap on AI reads per day (spend protection)
OCR_DAILY_LIMIT=500

# Rate limits per IP (in-memory)
RATE_READ_PER_MIN=120
RATE_WRITE_PER_HOUR=20
